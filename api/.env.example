# Copy this file to .env and fill values before running `docker-compose up`
# Example:
# POSTGRES_CONN=host=db user=timerwallet password=timerwallet dbname=timerwallet sslmode=disable

# DB connection string used by the app (optional - default is provided in compose)
POSTGRES_CONN=host=db user=timerwallet password=timerwallet dbname=timerwallet sslmode=disable

# Telegram bot token (required for production to verify initData)
BOT_TOKEN=123456:ABC-DEF_your_bot_token_here

# JWT secret used to sign access/refresh tokens (required)
JWT_SECRET=replace-with-a-strong-random-secret

# If set to 1, cookies will be created with Secure flag (useful behind HTTPS / Cloudflare)
COOKIE_SECURE=0

# Frontend: API base path (defaults to /api)
VITE_API_BASE=/api
